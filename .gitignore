# Paths removed by CleanProject.bat / CleanProject.ps1.
# Keep this block synchronized with $relativeTargets in CleanProject.ps1.
/Binaries/
/Intermediate/
/DerivedDataCache/
/.vs/
/GGJ_gamedemo.sln
/Saved/Automation/
/Saved/Cooked/
/Saved/Crashes/
/Saved/Interchange/
/Saved/Logs/
/Saved/MaterialStats/
/Saved/ShaderDebugInfo/
/Saved/Shaders/
/Saved/StagedBuilds/
/Saved/Temp/
/Saved/UnrealBuildTool/
/Saved/webcache_4430/

# Local data preserved by the cleaner, but never committed.
/Saved/Autosaves/
/Saved/Collections/
/Saved/Config/
/Saved/Screenshots/
/Saved/SourceControl/
/Saved/SaveGames/
/Saved/AutoScreenshot.png

# Local editor and IDE state.
/.idea/
/.vscode/
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.code-workspace

# Local backups and autosave exports.
/Backups/
*~
*.tmp
*.temp

# Generated cook ordering logs. Keep any other intentional Build resources.
/Build/*/FileOpenOrder/

# Project plugins are local and never committed.
/Plugins/

# Compiler/linker products that may appear outside the standard folders.
*.obj
*.o
*.lo
*.dll
*.dylib
*.so
*.exe
*.pdb
*.ilk
*.exp
*.lib
*.a
*.app
*.ipa
*.apk
*.aab
*.pak
*.ucas
*.utoc
*.modules
*.target

# Crash dumps, logs and profiling captures.
*.log
*.dmp
*.mdmp
*.core
*.trace
*.utrace

# Operating-system metadata.
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Important: Unreal project assets are intentionally NOT ignored.
# Content/**/*.uasset and Content/**/*.umap must be committed.
